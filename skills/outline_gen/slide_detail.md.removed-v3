# Slide Detail Skill — Stage 2: 章内每页 detail 填写

你正在为 **单个 chapter 的所有 slides** 填详细字段。Stage 1 (section_outline.md) 已经给你这一章的
stubs（每页的 archetype / archetype_placement / target_title / page_purpose_hint）, 你的任务是
把每个 stub 扩展成完整的 outline.slides[i]:
target_claim / page_purpose / key_points / needed_evidence / anchor_terms /
source_resource_ids / gap_research_hint / claim_status_link / expected_resource_kind。

**绝不修改** stub 已给的 archetype / archetype_placement / target_title / target_role / slide 顺序。
你的输出条数 = 输入 stubs 条数。

## Inputs

```json
{
  "chapter": {  // brief.chapter_plan[i] 的完整副本
    "section_index": 5,
    "chapter": "代表成果一: LLM 推理加速 ...",
    "purpose": "...",
    "expected_pages_indicative": 11,
    "delivery": {
      "must_start_with": "1 页回扣范式总图 + LLM 推理簇高亮",
      "must_end_with": "本章 LLM 推理代表数字小结 (24.89× / 4.54× / +6.2)"
    },
    "key_outcome": "...",
    "claims_to_make": [
      "SpeContext 长上下文 24.89× 吞吐",
      "Endor 近存架构 vs A100 2.97× / vs DFX 4.54×",
      ...
    ],
    "claims_to_setup_for_later": ["..."],
    "scope_out": ["..."],
    "needs_gap_research": false
  },
  "stubs": [  // Stage 1 输出
    {
      "slide_index_within_chapter": 1,
      "target_role": "method",
      "archetype": "single_framework_recall_5layer_diagram",
      "archetype_placement": "章首单页回扣范式图",
      "target_title": "范式坐标 · LLM 推理簇",
      "page_purpose_hint": "回扣 6 层框架并高亮本章覆盖的 LLM 推理簇"
    },
    ...
  ],
  "materials_candidates": [
    {"resource_id": "pdf_uuid_1", "priority": 0.95, "use_in_chapters": [5], "role": "main_evidence",
     "标题": "SpeContext: ...", "核心论断": "...", "关键图表索引": ["fig 3 throughput", ...]}
  ],
  "narrative_slice": {  // 全 brief.narrative_constraints 的本章相关切片
    "thesis_callback_role": "this chapter is one of callback_at_chapters",
    "anchor_terms_must_appear": ["软硬件协同", "近存架构"],
    "cross_section_hooks_in_or_out": [
      {"from": 4, "to": 5, "hook_type": "metric_teaser", "hook_content": "..."}
    ],
    "framework_anchor_repeat": {"this_chapter_repeats": true, "anchor": "5-layer-diagram"}
  },
  "brief_anchor_terms": ["软硬件协同", "稀疏激活", ...],  // brief.identity.anchor_terms 全集
  "claim_status_plan": [  // brief.claim_status_plan 全集
    {"claim_id": "c01", "claim": "...", "status": "asserted", "evidence_required": "..."},
    ...
  ],
  "gap_filling_recommendations": [  // brief.resource_anchor.gap_filling_recommendations (list[str])
    "课题组介绍: GAP_RESEARCH 检索 ...",
    ...
  ]
}
```


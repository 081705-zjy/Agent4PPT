# Copy this file to .env.local and fill values on your own machine.
# Never commit .env.local.

# Claude CLI API-key auth, if your Claude setup uses API keys.
# If you use `claude auth` subscription login instead, this can stay empty.
ANTHROPIC_API_KEY=

# Claude Code mirror/token auth, if your Claude CLI setup uses these variables.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=

# OpenAI-compatible provider keys used by configured chat providers.
INFINI_API_KEY=
OPENAI_API_KEY=

# Independent web search adapter. Pick one provider.
ENABLE_EXTERNAL_WEBSEARCH=true
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPER_API_KEY=
WEBSEARCH_TIMEOUT=20
WEBSEARCH_MAX_RESULTS=5
WEBFETCH_TIMEOUT=30
TAVILY_EXTRACT_DEPTH=basic

# Legacy only: increase when Claude search/fetch wrappers are explicitly used.
PPT_CLAUDE_TIMEOUT_SECONDS=60
PPT_AGENT_RESEARCH_TIMEOUT_SECONDS=90

# Optional: choose a different local app port.
PPT_AGENT_HOST=127.0.0.1
PPT_AGENT_PORT=8765
